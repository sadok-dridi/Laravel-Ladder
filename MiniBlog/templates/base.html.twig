{# templates/base.html.twig #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}My Symfony Blog - Default Title{% endblock %}</title>

    {# You can add common CSS files here later #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
{# This is the common header that appears on every page #}
<header>
    <nav>
        <h1>My Awesome Blog</h1>
        <ul>
            <li><a href="{{ path('homepage') }}">Home</a></li>
            <li><a href="{{ path('about_page') }}">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>
</header>

{# This is the main content area that child templates will fill #}
<main>
    {% block body %}
        {# This default content will be shown if a child template doesn't override this block #}
        <p>If you see this, the child template didn't define a 'body' block!</p>
    {% endblock %}
</main>

{# This is the common footer that appears on every page #}
<footer>
    <p>&copy; {{ "now"|date("Y") }} My Symfony Blog. All rights reserved.</p>
</footer>

{# You can add common JavaScript files here #}
<script src="{{ asset('js/app.js') }}"></script>
</body>
</html>
